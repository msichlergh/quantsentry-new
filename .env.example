# QuantSentry — environment variables
#
# Copy to .env.local for development:   cp .env.example .env.local
# .env* is gitignored except this file. NEVER put a real credential in here.
#
# Check what is set without printing any value:
#   node scripts/check-crm-env.mjs
#
# Verify the live GoHighLevel connection end to end (creates test records):
#   node scripts/verify-ghl.mjs --live


# ---------------------------------------------------------------------------
# CRM
# ---------------------------------------------------------------------------

# Which CRM adapter lib/crm uses. "ghl" (default) or "noop".
#
# "noop" logs submissions and delivers nothing. It is the right value for a
# preview deploy that must not write into the live CRM — but setting it by
# accident on production turns the demo wizard into a black hole that still
# answers HTTP 200.
CRM_PROVIDER=ghl

# GoHighLevel Private Integration token.
# Create in GHL: Settings > Private Integrations, scoped to the LOCATION (not
# the agency). Required scopes:
#   contacts.write        (contact upsert)
#   calendars.readonly    (free slots)
#   calendars/events.write (appointment creation)
#
# Server-only secret. Never prefix with NEXT_PUBLIC_ and never import lib/crm
# from a "use client" component.
GHL_API_TOKEN=pit-00000000-0000-0000-0000-000000000000

# The GHL sub-account (location) the contacts belong to.
# GHL: Settings > Business Profile, or the ID in the sub-account URL.
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# Calendar the demo wizard books against.
# GHL: Calendars > Calendar Settings > the calendar's ID.
#
# Only the booking half needs this. Without it, contact capture still works and
# the slot picker returns no availability — so a missing value here fails
# quietly on the calendar rather than taking lead capture down with it.
GHL_CALENDAR_ID=xxxxxxxxxxxxxxxxxxxx

# API version header sent to services.leadconnectorhq.com.
# HighLevel is mid-migration: existing Private Integration tokens run the dated
# "2021-07-28", newer docs show "v3". Leave unset unless the token was issued
# against v3.
# GHL_API_VERSION=2021-07-28


# ---------------------------------------------------------------------------
# Lead rescue
# ---------------------------------------------------------------------------

# Where a lead goes when the CRM write fails. Any endpoint that accepts a JSON
# POST — n8n, a Slack incoming webhook, Zapier.
#
# This is what stops a CRM outage from losing the submission, so it is worth
# setting in production even though the app runs without it. The payload is
# { lead, booking, error, contactId } — contactId is non-null when the contact
# was created and only the appointment failed.
# LEAD_FALLBACK_WEBHOOK_URL=https://example.com/webhook/quantsentry-lead


# ---------------------------------------------------------------------------
# Escape hatch
# ---------------------------------------------------------------------------

# Permit running without CRM credentials in a production-like environment.
#
# By default, production (VERCEL_ENV=production, or NODE_ENV=production when
# VERCEL_ENV is unset) REFUSES to fall back to the noop provider: /api/lead
# errors and routes the submission to LEAD_FALLBACK_WEBHOOK_URL instead of
# pretending it delivered. Development and preview always fall back quietly.
#
# Set to 1 only when you deliberately want a credential-free production build —
# e.g. `npm run build && npm start` locally. Leads are LOGGED, NOT DELIVERED.
# CRM_ALLOW_NOOP=1


# ---------------------------------------------------------------------------
# Bot protection — Cloudflare Turnstile (OPTIONAL, OFF by default)
# ---------------------------------------------------------------------------
#
# All three unset today, and the site behaves exactly as it did without them:
# the honeypot field, the render-timestamp check and the rate limiter are the
# defences. Setting them switches on server-side token verification in
# app/api/lead/route.ts and renders the widget in the forms.
#
# BOTH HALVES ARE NOW IMPLEMENTED. The widget (components/Turnstile.tsx) ships
# on the last step of the demo wizard and on the contact form, and posts its
# token to /api/lead as `cf-turnstile-response`. With no site key in the browser
# bundle it renders nothing, requests nothing, and the payload is unchanged.
#
# !! The site key is needed TWICE, under two names, with the SAME value. !!
#
#   TURNSTILE_SITE_KEY             server-side, gates verification on
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY browser-side, what the widget renders with
#
# They are the same string. Setting only TURNSTILE_SITE_KEY (plus the secret)
# turns verification on with NO widget in the browser: every submission arrives
# with no token, fails verification, and is SILENTLY DROPPED with a 200 — leads
# vanish and nothing looks broken. Setting only the NEXT_PUBLIC_ one renders the
# widget while the server ignores it, which is harmless but pointless.
#
# Order of operations: set all three together, then submit the demo form once
# and confirm the lead lands.
#
# Get keys at: https://dash.cloudflare.com > Turnstile > Add site
# Widget mode: Managed (or Invisible). The widget renders with
# appearance: "interaction-only", so a real visitor is only ever shown a
# challenge when Cloudflare decides they must solve one.
#
# Cloudflare's always-passes test pair, for local verification:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
#
# Public. Safe in the browser bundle — it is what the widget renders with.
# TURNSTILE_SITE_KEY=0x0000000000000000000000
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000
#
# Server-only secret. Never prefix with NEXT_PUBLIC_.
# TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000000


# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
#
# No configuration today. lib/rate-limit.ts uses an IN-MEMORY, PER-PROCESS
# fixed-window limiter with no env vars.
#
# Be honest about what that buys: on Vercel each serverless instance keeps its
# own counters, so a burst spread across warm instances gets roughly N x the
# limit and a cold start resets to zero. It stops a naive loop and a runaway
# client retry — the actual threat today — and nothing distributed.
#
# The seam for fixing that is the `RateLimitStore` interface in
# lib/rate-limit.ts. When shared counters are needed, implement it against
# Upstash Redis REST (INCR + PEXPIRE over plain fetch, no SDK) and document the
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN pair here at that point.
# The vars are deliberately NOT read today, so nobody can set them and believe
# distributed limiting is on.


# ---------------------------------------------------------------------------
# Analytics — Vercel Web Analytics + Speed Insights
# ---------------------------------------------------------------------------
#
# No credentials. Both scripts are served same-origin from /_vercel/ by the
# platform, so there is nothing to configure here and nothing to keep secret.
# They are turned on per project in the Vercel dashboard, not from this file:
#   Project > Analytics > Enable, and Project > Speed Insights > Enable.
#
# Until those two toggles are on, the client keeps sending and Vercel discards
# the events — the site behaves identically, the dashboard just stays empty.
#
# Neither sets a cookie nor builds a cross-site profile, which is why no
# consent banner was added. If a provider that DOES need consent is ever
# adopted, it needs a consent surface first — do not swap one in behind this
# flag.

# Hard off switch for both scripts AND every custom event. Unset means ON.
#
# Deliberately fail-open: an analytics flag that defaults to off is a flag
# somebody forgets to set, and the first week of launch traffic is the week
# you cannot re-measure.
#
# Set to 1 for a local `npm run build && npm start`, where /_vercel/* does not
# exist and the scripts would 404 on every page load. Public by necessity —
# it is read in the browser bundle.
# NEXT_PUBLIC_ANALYTICS_DISABLED=1
